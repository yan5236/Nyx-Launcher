<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType>
  <TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
 </PropertyGroup>
 <ItemGroup>
  <Content Include="../../src/NyxLauncher/Assets/Launch/*" Link="Assets/Launch/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  <EmbeddedResource Include="../../config/microsoft-auth.example.json" LogicalName="NyxLauncher.MicrosoftAuth.json" />
  <PackageReference Include="CmlLib.Core" Version="4.1.0" />
  <PackageReference Include="SkiaSharp" Version="4.154.0" />
  <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
  <Compile Include="../../src/NyxLauncher/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
  <Compile Include="../../src/NyxLauncher/Views/DownloadEntry.cs" Link="DownloadEntry.cs" />
 </ItemGroup>
</Project>
