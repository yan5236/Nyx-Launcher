<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WinUI 模板的交互状态在控件所在树中解析；页面和弹窗均合并此字典，防止回落到系统蓝色。 -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#28563B" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#346C4B" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#20452F" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#28563B" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#346C4B" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#20452F" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#28563B" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#346C4B" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#20452F" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
</ResourceDictionary>
