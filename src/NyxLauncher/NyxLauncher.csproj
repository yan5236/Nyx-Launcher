<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MicrosoftAuthConfig Condition="'$(MicrosoftAuthConfig)' == ''">$(MSBuildProjectDirectory)\..\..\config\microsoft-auth.json</MicrosoftAuthConfig>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\FeaturedServers.json" LogicalName="NyxLauncher.FeaturedServers.json" />
    <EmbeddedResource Include="Assets\ThirdPartyNotices.json" LogicalName="NyxLauncher.ThirdPartyNotices.json" />
  <Content Include="Assets\Launch\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(MicrosoftAuthConfig)" LogicalName="NyxLauncher.MicrosoftAuth.json" />
    <AssemblyMetadata Include="SingleFile" Value="$(PublishSingleFile)" />
    <Content Include="..\..\USER_AGREEMENT.md" Link="USER_AGREEMENT.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Scenes\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>
  <Target Name="RequireMicrosoftAuthConfig" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MicrosoftAuthConfig)')"
           Text="缺少 config/microsoft-auth.json，请复制 config/microsoft-auth.example.json 并填写自己的 ClientId 后构建。" />
  </Target>
</Project>
