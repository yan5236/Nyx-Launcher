<ContentDialog x:Class="NyxLauncher.Views.LaunchFailureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="确定" DefaultButton="Close">
    <ContentDialog.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/AccentButtonResources.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid MinWidth="420" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="启动失败" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="关闭启动失败提示" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <StackPanel Spacing="16">
        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Reason" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="OpenLog" Content="用记事本打开日志" Click="OpenLog_Click" />
            <Button x:Name="OpenFolder" Content="打开日志文件夹" Click="OpenFolder_Click" />
        </StackPanel>
        <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>
