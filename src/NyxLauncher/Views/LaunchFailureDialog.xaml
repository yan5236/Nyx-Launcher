<ContentDialog x:Class="NyxLauncher.Views.LaunchFailureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <ContentDialog.Title>
        <Grid MinWidth="420" Width="{Binding ActualWidth, ElementName=Body}" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Text="启动失败" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="关闭提示" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <StackPanel x:Name="Body" Spacing="16">
        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Reason" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
        <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
        <TextBlock x:Name="HelpHint" TextWrapping="Wrap" Text="如果你需要寻求他人帮助，不要截图这个弹窗！你应该点击导出日志，将日志交给他人分析。" />
        <Grid ColumnSpacing="8" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenLog" Height="38" Content="打开日志" Click="OpenLog_Click" />
            <Button x:Name="OpenFolder" Height="38" Grid.Column="1" Content="打开日志文件夹" Click="OpenFolder_Click" />
            <Button x:Name="ExportLog" Height="38" Grid.Column="2" Content="导出日志" Click="ExportLog_Click" />
            <Button Grid.Column="3" Height="38" Content="确定" Click="Close_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</ContentDialog>
