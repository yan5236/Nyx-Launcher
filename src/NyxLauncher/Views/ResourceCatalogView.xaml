<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.ResourceCatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="using:NyxLauncher.Services" xmlns:views="using:NyxLauncher.Views">
 <UserControl.Resources><views:ResourceLoaderIconConverter x:Key="LoaderIconConverter"/></UserControl.Resources>
 <Grid RowSpacing="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="搜索模组" KeyDown="SearchBox_KeyDown"
    AutomationProperties.Name="搜索资源" FontSize="15"/>
   <Button Grid.Column="1" Content="搜索" Click="Search_Click" MinWidth="88"
    Style="{StaticResource AccentButtonStyle}"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="6">
    <TextBlock Text="版本" VerticalAlignment="Center"/>
    <ComboBox x:Name="GameVersionFilter" HorizontalAlignment="Stretch"
     IsEditable="True" IsTextSearchEnabled="False" TextSubmitted="GameVersionFilter_TextSubmitted"
     SelectionChanged="GameVersionFilter_SelectionChanged" AutomationProperties.Name="Minecraft 版本筛选"/>
   </StackPanel>
   <StackPanel x:Name="LoaderControls" Grid.Column="1" Spacing="6">
    <TextBlock Text="加载器" VerticalAlignment="Center"/>
    <ComboBox x:Name="LoaderFilter" Width="134" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged"
     AutomationProperties.Name="加载器筛选">
     <ComboBoxItem Content="全部" Tag=""/>
     <ComboBoxItem Content="Fabric" Tag="fabric"/><ComboBoxItem Content="Forge" Tag="forge"/>
     <ComboBoxItem Content="NeoForge" Tag="neoforge"/><ComboBoxItem Content="Quilt" Tag="quilt"/>
     <ComboBoxItem Content="LiteLoader" Tag="liteloader"/><ComboBoxItem Content="Rift" Tag="rift"/>
    </ComboBox>
   </StackPanel>
   <StackPanel Grid.Column="2" Spacing="6">
    <TextBlock Text="类型"/>
    <ComboBox x:Name="CategoryFilter" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Id"
     SelectionChanged="Filter_SelectionChanged" AutomationProperties.Name="资源类型筛选"/>
   </StackPanel>
   <StackPanel Grid.Column="3" Spacing="6">
    <TextBlock Text="来源" VerticalAlignment="Center"/>
    <ComboBox x:Name="SourceFilter" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged"
     AutomationProperties.Name="资源来源筛选">
     <ComboBoxItem Content="全部"/><ComboBoxItem Content="Modrinth"/>
     <ComboBoxItem Content="CurseForge（暂不可用）" IsEnabled="False"/>
    </ComboBox>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <ListView x:Name="ProjectList" SelectionMode="None" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="ProjectList_ItemClick"
    Margin="0,0,-20,0" Padding="0,0,20,10" ScrollViewer.VerticalScrollBarVisibility="Auto"
    AutomationProperties.Name="资源列表">
    <ListView.ItemContainerStyle>
     <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
     </Style>
    </ListView.ItemContainerStyle>
    <ListView.ItemTemplate>
     <DataTemplate x:DataType="services:ResourceProject">
      <Grid ColumnSpacing="16" AutomationProperties.Name="{x:Bind Title}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <views:ResourceIcon Project="{x:Bind}" Width="64" Height="64" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
         ToolTipService.ToolTip="{x:Bind Title}"/>
        <TextBlock Text="{x:Bind Description}" FontSize="13" Foreground="#6B7A70" TextTrimming="CharacterEllipsis"
         ToolTipService.ToolTip="{x:Bind Description}"/>
        <RichTextBlock FontSize="12" Foreground="#6B7A70" TextWrapping="Wrap" IsTextSelectionEnabled="False">
         <Paragraph>
          <InlineUIContainer><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0" ToolTipService.ToolTip="下载量">
           <FontIcon Glyph="&#xE896;" FontSize="12"/><TextBlock Text="{x:Bind DownloadText}" FontSize="12"/>
          </StackPanel></InlineUIContainer>
          <InlineUIContainer><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"
           Visibility="{x:Bind HasLoaders}" ToolTipService.ToolTip="{x:Bind LoadersText}">
           <ItemsControl ItemsSource="{x:Bind LoaderIcons}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Converter={StaticResource LoaderIconConverter}}" Width="14" Height="14"/></DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
           <TextBlock Text="{x:Bind LoadersText}" FontSize="12"/>
          </StackPanel></InlineUIContainer>
          <InlineUIContainer><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0" ToolTipService.ToolTip="{x:Bind VersionsDetail}">
           <FontIcon Glyph="&#xE7FC;" FontSize="12"/><TextBlock Text="{x:Bind VersionsText}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
          </StackPanel></InlineUIContainer>
          <InlineUIContainer><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,0" ToolTipService.ToolTip="来源">
           <FontIcon Glyph="&#xE774;" FontSize="12"/><TextBlock Text="Modrinth" FontSize="12"/>
          </StackPanel></InlineUIContainer>
          <InlineUIContainer><StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="更新日期">
           <FontIcon Glyph="&#xE787;" FontSize="12"/><TextBlock Text="{x:Bind UpdatedText}" FontSize="12"/>
          </StackPanel></InlineUIContainer>
         </Paragraph>
        </RichTextBlock>
       </StackPanel>
      </Grid>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <views:VersionLoadStatus x:Name="LoadStatus" Visibility="Collapsed"/>
   <TextBlock x:Name="EmptyHint" Text="没有匹配的内容" FontSize="15" Foreground="#6B7A70"
    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid>
  <StackPanel x:Name="Pagination" Grid.Row="3" Orientation="Horizontal" Spacing="12"
   HorizontalAlignment="Right" Visibility="Collapsed">
   <Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click"/>
   <TextBlock x:Name="PageText" VerticalAlignment="Center"/>
   <Button x:Name="NextButton" Content="下一页" Click="Next_Click"/>
  </StackPanel>
 </Grid>
</UserControl>
