<UserControl x:Class="NyxLauncher.Views.AppearanceSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="16">
   <ComboBox x:Name="Mode" Header="外观" HorizontalAlignment="Stretch" SelectionChanged="Options_Changed" AutomationProperties.Name="外观">
    <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
   </ComboBox>
   <ComboBox x:Name="Preset" Header="主题色" HorizontalAlignment="Stretch" SelectionChanged="Options_Changed" AutomationProperties.Name="主题色">
    <ComboBoxItem Content="绿色"/><ComboBoxItem Content="WinUI 经典蓝"/><ComboBoxItem Content="自定义"/>
   </ComboBox>
   <StackPanel x:Name="CustomPanel" x:Load="False" Spacing="12" Visibility="Collapsed">
    <ComboBox x:Name="ColorMode" Header="自定义配色" SelectedIndex="0" SelectionChanged="ColorMode_Changed" AutomationProperties.Name="自定义配色">
     <ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
    </ComboBox>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Button Content="色调"><Button.Flyout><Flyout><ColorPicker x:Name="Tone" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" AutomationProperties.Name="色调"/></Flyout></Button.Flyout></Button>
     <Button Content="主色"><Button.Flyout><Flyout><ColorPicker x:Name="Primary" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" AutomationProperties.Name="主色"/></Flyout></Button.Flyout></Button>
     <Button Content="副色"><Button.Flyout><Flyout><ColorPicker x:Name="Secondary" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" AutomationProperties.Name="副色"/></Flyout></Button.Flyout></Button>
     <Button Content="应用" Click="ApplyColors_Click"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Spacing="8">
    <TextBlock Text="背景图片"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Button x:Name="ChooseImage" Content="选择图片" Click="ChooseImage_Click"/>
     <Button x:Name="RemoveImage" Content="移除" Click="RemoveImage_Click"/>
    </StackPanel>
    <Slider x:Name="OpacitySlider" Header="不透明度" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Opacity_Changed" AutomationProperties.Name="背景图片不透明度"/>
   </StackPanel>
   <Slider x:Name="SidebarOpacitySlider" Header="侧栏背景不透明度" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="SidebarOpacity_Changed" AutomationProperties.Name="侧栏背景不透明度"/>
   <StackPanel Spacing="8">
    <TextBlock Text="首页图片" />
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Button x:Name="ChooseHomeImage" Content="更换图片" Click="ChooseImage_Click" />
     <Button x:Name="RemoveHomeImage" Content="移除" Click="RemoveHomeImage_Click" />
     <Button x:Name="RestoreHomeImage" Content="恢复默认" Click="RestoreHomeImage_Click" />
    </StackPanel>
   </StackPanel>
   <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
  </StackPanel>
 </Border>
</UserControl>
