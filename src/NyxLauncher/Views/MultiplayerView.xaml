<UserControl x:Class="NyxLauncher.Views.MultiplayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer x:Name="MultiplayerScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="12" Padding="0,0,16,24">
   <InfoBar x:Name="Feedback" IsClosable="True"/>
   <StackPanel x:Name="Overview" Spacing="12">
    <TextBlock Text="联机" Style="{StaticResource TitleTextBlockStyle}"/>
    <InfoBar x:Name="ActiveRoom" Severity="Informational" IsClosable="False">
     <InfoBar.ActionButton><Button Content="返回房间" Click="Resume_Click"/></InfoBar.ActionButton>
    </InfoBar>
    <Border Style="{StaticResource CardStyle}">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="启用联机模块" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                    AutomationProperties.Name="启用联机模块" Toggled="Enabled_Toggled"/>
     </Grid>
    </Border>
    <Button x:Name="HostButton" Click="Host_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="16,14" AutomationProperties.Name="我是房主">
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <SymbolIcon Symbol="Home"/>
      <StackPanel Grid.Column="1" Spacing="4">
       <TextBlock Text="我是房主" Style="{StaticResource SubtitleTextBlockStyle}"/>
       <TextBlock Text="邀请他人加入房间" Foreground="{ThemeResource MutedBrush}"/>
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14"/>
     </Grid>
    </Button>
    <Button x:Name="JoinButton" Click="Join_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="16,14" AutomationProperties.Name="我是访客">
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <SymbolIcon Symbol="People"/>
      <StackPanel Grid.Column="1" Spacing="4">
       <TextBlock Text="我是访客" Style="{StaticResource SubtitleTextBlockStyle}"/>
       <TextBlock Text="加入他人的房间" Foreground="{ThemeResource MutedBrush}"/>
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14"/>
     </Grid>
    </Button>
    <TextBlock x:Name="OverviewStatus" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="用户须知"
             Message="陶瓦联机是第三方开源软件，由陶瓦项目提供支持。请通过项目渠道反馈问题，并遵守所在国家与地区的法律法规。请仅向信任的人分享邀请码，点对点连接的对端可能看到你的公网 IP。"/>
    <TextBlock TextWrapping="Wrap">
     <Hyperlink NavigateUri="https://github.com/burningtnt/Terracotta">Terracotta | 陶瓦联机 © Burning_TNT 与贡献者</Hyperlink>
     <Run Text=" · "/>
     <Hyperlink NavigateUri="https://github.com/EasyTier/EasyTier">EasyTier © EasyTier 贡献者</Hyperlink>
    </TextBlock>
   </StackPanel>
   <StackPanel x:Name="RoomDetail" Spacing="12" Visibility="Collapsed">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="BackButton" Click="Back_Click" AutomationProperties.Name="返回联机首页" ToolTipService.ToolTip="返回联机首页">
      <SymbolIcon Symbol="Back"/>
     </Button>
     <TextBlock x:Name="RoomTitle" Grid.Column="1" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
     <Button x:Name="LeaveButton" Grid.Column="2" VerticalAlignment="Center" Click="Leave_Click"/>
    </Grid>
    <Grid x:Name="RoomColumns" ColumnSpacing="16" RowSpacing="12" SizeChanged="RoomColumns_SizeChanged">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource CardStyle}">
      <StackPanel Spacing="8">
       <TextBlock Text="玩家列表" Style="{StaticResource SubtitleTextBlockStyle}"/>
       <TextBlock x:Name="PlayersHint" Foreground="{ThemeResource MutedBrush}"/>
       <ItemsControl x:Name="Players">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
     <StackPanel x:Name="RoomInfo" Grid.Column="1" Spacing="12">
      <TextBlock x:Name="RoomStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="ConnectionValue" Header="邀请码" IsReadOnly="True"/>
       <Button x:Name="CopyButton" Grid.Column="1" Content="复制" VerticalAlignment="Bottom" Click="Copy_Click"/>
      </Grid>
      <TextBox x:Name="GuestAddress" Header="游戏直连地址" IsReadOnly="True" Visibility="Collapsed"/>
      <Button x:Name="CopyAddressButton" Content="复制服务器地址" Visibility="Collapsed" Click="Copy_Click"/>
      <TextBlock x:Name="RoleTutorial" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
