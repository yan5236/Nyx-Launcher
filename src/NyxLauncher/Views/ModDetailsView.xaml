<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.ModDetailsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Button Click="Back_Click" ToolTipService.ToolTip="返回模组列表" AutomationProperties.Name="返回模组列表">
   <FontIcon Glyph="&#xE72B;" FontSize="16"/>
  </Button>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <views:ResourceIcon x:Name="ProjectIcon" Width="72" Height="72" VerticalAlignment="Top"/>
    <StackPanel Grid.Column="1" Spacing="10">
     <TextBlock x:Name="ModTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="Description" Foreground="#6B7A70" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis"/>
     <StackPanel Orientation="Horizontal" Spacing="10">
      <Button x:Name="CopyButton" Click="Copy_Click" AutomationProperties.Name="复制模组名称">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14"/><TextBlock Text="复制名称"/></StackPanel>
      </Button>
      <Button Click="Website_Click" AutomationProperties.Name="在浏览器打开 Modrinth 模组详情">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE774;" FontSize="14"/><TextBlock Text="前往 Modrinth"/></StackPanel>
      </Button>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="PreviousStep" Click="Previous_Click" IsEnabled="False" VerticalAlignment="Center"
    ToolTipService.ToolTip="返回上一步" AutomationProperties.Name="返回上一步">
    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
   </Button>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Image Source="ms-appx:///Assets/java-mojang.png" Width="28" Height="28"/>
     <TextBlock x:Name="StageText" Text="选择 Minecraft 版本" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False"/>
  <Grid Grid.Row="4">
   <ListView x:Name="Choices" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Choice_Click"
    Margin="0,0,-20,0" Padding="0,0,20,10" AutomationProperties.Name="模组版本选择">
    <ListView.ItemContainerStyle>
     <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="MinHeight" Value="72"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
     </Style>
    </ListView.ItemContainerStyle>
    <ListView.ItemTemplate>
     <DataTemplate>
      <Grid ColumnSpacing="14" AutomationProperties.Name="{Binding AccessibleName}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Width="40" Height="40">
        <Image Source="{Binding Icon}" Width="32" Height="32" Visibility="{Binding IconVisibility}"/>
        <Border Background="{Binding BadgeBackground}" CornerRadius="6" Visibility="{Binding BadgeVisibility}">
         <TextBlock Text="{Binding Badge}" FontSize="22" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
       </Grid>
       <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}"/>
        <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="13" Foreground="#6B7A70" TextWrapping="Wrap"/>
       </StackPanel>
       <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="#6B7A70" VerticalAlignment="Center"/>
      </Grid>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <views:VersionLoadStatus x:Name="LoadStatus" Visibility="Collapsed"/>
   <TextBlock x:Name="EmptyHint" Text="该模组暂无可下载的运行文件" Visibility="Collapsed"
    HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7A70"/>
  </Grid>
 </Grid>
</UserControl>
