<UserControl x:Class="NyxLauncher.Views.ServersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="服务器分类">
    <SelectorBarItem Text="服务器" IsSelected="True"/>
    <SelectorBarItem x:Name="FeaturedTab" Text="精选服务器"/>
   </SelectorBar>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ProgressRing x:Name="Refreshing" Width="24" Height="24" Visibility="Collapsed"
                  AutomationProperties.Name="正在刷新服务器"/>
    <Button x:Name="RefreshButton" Click="Refresh_Click" AutomationProperties.Name="刷新服务器"
            ToolTipService.ToolTip="刷新服务器">
     <SymbolIcon Symbol="Refresh"/>
    </Button>
    <Button x:Name="AddButton" Content="添加服务器" Click="Add_Click"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="Disclaimer" Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed"
             Foreground="{ThemeResource MutedBrush}"><Run Text="服务器由第三方运营，"/><Run Text="Nyx Launcher" FontWeight="SemiBold"/><Run Text="不对服务器的行为负责。"/></TextBlock>
  <InfoBar x:Name="Feedback" Grid.Row="2" Severity="Error" IsClosable="True"/>
  <Grid Grid.Row="3">
   <ScrollViewer x:Name="ServerScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Cards" Spacing="8" Padding="0,0,4,16"/>
   </ScrollViewer>
   <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
    <FontIcon Glyph="&#xEC05;" FontSize="48" Foreground="{ThemeResource MutedBrush}"/>
    <TextBlock Text="暂时没有服务器呢，点击右上角或下方添加" Foreground="{ThemeResource MutedBrush}"
               TextAlignment="Center" TextWrapping="Wrap"/>
    <Button x:Name="EmptyAddButton" Style="{StaticResource DeepButtonStyle}" Click="Add_Click"
            Background="{ThemeResource AccentButtonBackground}" BorderBrush="{ThemeResource AccentButtonBackground}"
            Foreground="{ThemeResource AccentButtonForeground}"
            HorizontalAlignment="Center" AutomationProperties.Name="添加服务器">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource AccentButtonForeground}"/><TextBlock Text="添加服务器" Foreground="{ThemeResource AccentButtonForeground}"/></StackPanel>
    </Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="EditorLayer" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed"
        TabFocusNavigation="Cycle" AutomationProperties.Name="服务器信息" SizeChanged="EditorLayer_SizeChanged">
   <ScrollViewer x:Name="EditorScroll" HorizontalAlignment="Center" VerticalAlignment="Center"
                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border x:Name="EditorPanel" Style="{StaticResource CardStyle}" Padding="24">
     <Border.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="EditorEscape_Invoked"/>
     </Border.KeyboardAccelerators>
     <Grid RowSpacing="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="EditorTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button x:Name="EditorClose" Grid.Column="1" Click="EditorClose_Click" Background="Transparent" BorderThickness="0" Padding="10"
               AutomationProperties.Name="关闭服务器信息" ToolTipService.ToolTip="关闭">
        <FontIcon Glyph="&#xE711;" FontSize="18"/>
       </Button>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="12">
       <TextBox x:Name="EditorName" Header="服务器名" MaxLength="100" AutomationProperties.Name="服务器名"
                KeyDown="EditorField_KeyDown"/>
       <TextBox x:Name="EditorAddress" Header="服务器地址" MaxLength="260"
                PlaceholderText="example.org:25565" AutomationProperties.Name="服务器地址" KeyDown="EditorField_KeyDown"/>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="默认启动版本（可选）" VerticalAlignment="Center"/>
        <Button x:Name="EditorClearVersion" Grid.Column="1" Content="清除绑定" Click="EditorClearVersion_Click"
                Visibility="Collapsed" AutomationProperties.Name="清除默认启动版本"/>
       </Grid>
       <Button x:Name="EditorVersion" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
               Background="Transparent" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Padding="12"
               CornerRadius="6" Click="EditorVersion_Click" AutomationProperties.Name="启动版本">
        <Grid ColumnSpacing="12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <views:VersionIcon x:Name="EditorVersionIcon" Width="36" Height="36"/>
         <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="EditorVersionName" Text="未选择启动版本" FontSize="15" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="EditorVersionDetail" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                     TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/>
        </Grid>
       </Button>
       <InfoBar x:Name="EditorError" Severity="Error" IsClosable="False"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
       <Button x:Name="EditorCancel" Content="取消" Click="EditorCancel_Click" AutomationProperties.Name="取消编辑服务器"/>
       <Button x:Name="EditorSave" Content="保存" Click="EditorSave_Click" Style="{StaticResource DeepButtonStyle}"
               Background="{ThemeResource AccentButtonBackground}" BorderBrush="{ThemeResource AccentButtonBackground}"
               Foreground="{ThemeResource AccentButtonForeground}" AutomationProperties.Name="保存服务器"/>
      </StackPanel>
     </Grid>
    </Border>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
