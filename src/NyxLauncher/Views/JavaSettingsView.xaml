<UserControl x:Class="NyxLauncher.Views.JavaSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,0,16,0">
   <Button x:Name="ImportButton" Content="导入 Java" Click="Import_Click"/>
   <Button x:Name="ScanButton" Content="扫描 Java" Click="Scan_Click"/>
   <Button x:Name="InstallButton" Content="安装 Java" Click="Install_Click" Style="{StaticResource DeepButtonStyle}"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
   <StackPanel Spacing="10">
    <TextBlock Text="Java 版本检查（x64）" FontWeight="SemiBold"/>
    <ItemsControl x:Name="Coverage">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border Background="{ThemeResource ShellBrush}" CornerRadius="6" Padding="10,8"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <StackPanel x:Name="Scanning" Grid.Row="2" Spacing="8" Visibility="Collapsed" Margin="0,0,16,0">
   <ProgressBar IsIndeterminate="True"/>
   <TextBlock x:Name="ScanStatus" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
  </StackPanel>
  <ListView x:Name="JavaList" Grid.Row="3" SelectionMode="None" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="本地 Java 列表">
   <ListView.Header>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,10">
     <RadioButton x:Name="Automatic" GroupName="JavaSelection" Checked="Automatic_Checked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <TextBlock Text="自动选择" FontWeight="SemiBold"/>
     </RadioButton>
    </Border>
   </ListView.Header>
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,10"/></Style></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate x:DataType="views:JavaRuntimeChoice">
    <Border Style="{StaticResource CardStyle}">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <RadioButton GroupName="JavaSelection" Tag="{x:Bind Runtime.Home}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Checked="Java_Checked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Runtime.Title}">
       <StackPanel Spacing="5"><TextBlock Text="{x:Bind Runtime.Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Runtime.Detail}" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" FontSize="12"/></StackPanel>
      </RadioButton>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Tag="{x:Bind Runtime.Home}" Click="Folder_Click" ToolTipService.ToolTip="打开文件夹" AutomationProperties.Name="打开 Java 文件夹"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button>
       <Button Tag="{x:Bind Runtime.Home}" Click="Remove_Click" ToolTipService.ToolTip="从列表移除，不删除文件" AutomationProperties.Name="从列表移除 Java"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate></ListView.ItemTemplate>
   <ListView.Footer><TextBlock x:Name="Empty" Text="未发现 Java" Foreground="{ThemeResource MutedBrush}"/></ListView.Footer>
  </ListView>
  <InfoBar x:Name="Status" Grid.Row="4" IsClosable="True" Margin="0,0,16,0"/>
 </Grid>
</UserControl>
