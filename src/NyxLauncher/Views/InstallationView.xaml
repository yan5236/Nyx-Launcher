<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.InstallationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="0,0,0,10">
            <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="10"
                    AutomationProperties.Name="返回游戏版本列表" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="20" />
            </Button>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#E0EBD6" Width="64" Height="64" CornerRadius="8">
                    <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="#397450" />
                </Border>
                <TextBox x:Name="VersionName" Grid.Column="1" FontSize="20" VerticalAlignment="Center"
                         Padding="12,10" PlaceholderText="版本名称" MaxLength="128"
                         AutomationProperties.Name="版本名称" />
                <Button x:Name="InstallButton" Grid.Column="2" MinWidth="96" Padding="20,12"
                        VerticalAlignment="Center" AutomationProperties.Name="安装"
                        AutomationProperties.HelpText="游戏安装尚未接入"
                        ToolTipService.ToolTip="游戏安装尚未接入">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                        <TextBlock Text="安装" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Spacing="10">
                <Border Style="{StaticResource CardStyle}" Padding="12,10" MinHeight="56">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/forge.png" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="Forge 图标" />
                        <TextBlock Grid.Column="1" Text="Forge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ForgeStatus" Grid.Column="2" FontSize="13" Foreground="#6B7A70" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="14" Foreground="#87928A" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12,10" MinHeight="56">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/fabric.png" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="Fabric 图标" />
                        <TextBlock Grid.Column="1" Text="Fabric" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="FabricStatus" Grid.Column="2" FontSize="13" Foreground="#6B7A70" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="14" Foreground="#87928A" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12,10" MinHeight="56">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/neoforge.png" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="NeoForge 图标" />
                        <TextBlock Grid.Column="1" Text="NeoForge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="NeoForgeStatus" Grid.Column="2" FontSize="13" Foreground="#6B7A70" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="14" Foreground="#87928A" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
