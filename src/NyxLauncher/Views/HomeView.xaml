<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <TextBlock Text="首页" Style="{StaticResource PageTitleStyle}" />
        <Border CornerRadius="8" Background="#DDE8CD">
            <Grid Height="250">
                <Image Source="ms-appx:///Assets/Landscape.svg" Stretch="UniformToFill" />
                <TextBlock Text="我的世界" Margin="24" VerticalAlignment="Top"
                           FontSize="28" FontWeight="SemiBold" Foreground="#233F31" />
            </Grid>
        </Border>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox SelectedIndex="0" FontSize="15" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      AutomationProperties.Name="游戏版本">
                <ComboBoxItem Content="1.21.4 · 原版" />
                <ComboBoxItem Content="1.21.4 · Fabric" />
                <ComboBoxItem Content="1.20.1 · Forge" />
            </ComboBox>
            <Button Grid.Column="1" IsEnabled="False" VerticalAlignment="Center" Padding="22,11"
                    Background="#397450" Foreground="White" AutomationProperties.Name="启动游戏，原型暂不可用">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#397450" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                    <TextBlock Text="启动游戏" FontSize="16" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
