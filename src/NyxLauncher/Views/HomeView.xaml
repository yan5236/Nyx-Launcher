<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border CornerRadius="8" Background="#DDE8CD">
            <Image x:Name="HeroImage" Height="250" Source="ms-appx:///Assets/HomeLandscape.jpg" Stretch="UniformToFill"
                   AutomationProperties.Name="Minecraft 湖畔风景" />
        </Border>
        <Grid x:Name="ProgressSpace" Height="64">
            <Grid x:Name="LaunchProgress" Opacity="0" Visibility="Collapsed" ColumnSpacing="18" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform x:Name="ProgressTranslation" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StageLabel" MaxWidth="300" FontSize="12" Foreground="#596D60"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="StageProgress" Grid.Column="1" Minimum="0" Maximum="100" Height="5"
                             VerticalAlignment="Center" Foreground="#397450" Background="#E0EBD6" AutomationProperties.Name="启动进度" />
            </Grid>
        </Grid>
        <Grid x:Name="LaunchArea" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="VersionList" MinHeight="72" MinWidth="0" FontSize="15" Padding="12,8"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                      SelectionChanged="Version_SelectionChanged" PlaceholderText="请先安装游戏" AutomationProperties.Name="游戏版本">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" SizeChanged="VersionCard_SizeChanged" ToolTipService.ToolTip="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="#397450" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LaunchDetail}" FontSize="11" Foreground="#6B7A70" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="LaunchButton" Grid.Column="1" Click="Launch_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="72" VerticalAlignment="Center" Padding="12"
                    Style="{StaticResource DeepButtonStyle}" AutomationProperties.Name="启动游戏">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon x:Name="LaunchIcon" Glyph="&#xE768;" FontSize="16" />
                        <TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="16" Foreground="White" />
                    </StackPanel>
                    <TextBlock x:Name="LaunchVersionLabel" Text="请先选择版本" FontSize="12" Foreground="#E4EEE7"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <Button x:Name="ManageButton" Grid.Column="2" Click="Manage_Click" HorizontalAlignment="Stretch" MinHeight="72"
                    VerticalAlignment="Center" Padding="12" AutomationProperties.Name="管理所选版本">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ManageIcon" Glyph="&#xE713;" FontSize="16" /><TextBlock x:Name="ManageLabel" Text="版本管理" FontSize="16" />
                </StackPanel>
            </Button>
        </Grid>
        <InfoBar x:Name="Status" Margin="0,12,0,0" IsClosable="True" />
    </StackPanel>
</UserControl>
