<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NyxLauncher.Views">
    <Grid x:Name="Root" MinHeight="360">
        <!-- 世界画面：图片画笔圆角裁切，避免子元素溢出圆角 -->
        <Border x:Name="StageCard" Width="760" Height="480" CornerRadius="18" HorizontalAlignment="Center"
                VerticalAlignment="Center" AutomationProperties.Name="启动画面">
            <Border.Background>
                <ImageBrush x:Name="StageImage" ImageSource="ms-appx:///Assets/HomeLandscape.jpg" Stretch="UniformToFill"
                            AlignmentX="Center" AlignmentY="Center" />
            </Border.Background>

            <Grid>
                <!-- 底部压暗：让悬浮控制台落在画面暗部，底部不与亮水面对撞 -->
                <Border x:Name="BottomShade" Height="220" VerticalAlignment="Bottom" CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#0008100C" Offset="0.32" />
                            <GradientStop Color="#4008100C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 暗角：把视线收进画面中心，边缘不与浅色页面直接相接 -->
                <Border x:Name="EdgeShade" CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.78" RadiusY="0.9">
                            <GradientStop Color="#00000000" Offset="0.45" />
                            <GradientStop Color="#2E08100C" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 底部控制台：版本选择器、启动进度与主操作始终固定尺寸 -->
                <Border x:Name="Deck" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,22,22"
                        MaxWidth="800" Padding="14" CornerRadius="14"
                        Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="SelectorHost" Height="64" MaxWidth="430" HorizontalAlignment="Stretch">
                            <ComboBox x:Name="VersionList" MinWidth="0" Height="64" MaxWidth="430" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Padding="12,0,10,0"
                                      Background="{ThemeResource CardHoverBrush}"
                                      PlaceholderText="请先安装游戏" SelectionChanged="Version_SelectionChanged"
                                      AutomationProperties.Name="游戏版本">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="11" MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <views:VersionIcon Version="{Binding}" Width="30" Height="30" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LaunchDetail}" FontSize="11.5"
                                                           Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid x:Name="LaunchProgress" Opacity="0" Visibility="Collapsed" ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ProgressTranslation" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="StageLabel" FontSize="13" Foreground="{ThemeResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="ProgressPercent" Grid.Column="1" FontSize="13" Foreground="{ThemeResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <ProgressBar x:Name="StageProgress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                             Minimum="0" Maximum="100" Height="5" VerticalAlignment="Center"
                                             Foreground="{ThemeResource SecondaryBrush}" Background="{ThemeResource TintBrush}"
                                             AutomationProperties.Name="启动进度" />
                            </Grid>
                        </Grid>

                        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="ManageButton" Click="Manage_Click" Height="44" Padding="15,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="管理所选版本">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon x:Name="ManageIcon" Glyph="&#xE8F1;" FontSize="15" />
                                    <TextBlock x:Name="ManageLabel" Text="版本管理" FontSize="13.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LaunchButton" Click="Launch_Click" Width="196" Height="56" Padding="0"
                                    VerticalAlignment="Center" Style="{StaticResource DeepButtonStyle}"
                                    AutomationProperties.Name="启动游戏">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon x:Name="LaunchIcon" Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="16" Foreground="{ThemeResource AccentButtonForeground}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,132"
                         MaxWidth="620" IsClosable="True" Background="{ThemeResource CardBrush}"
                         BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
