<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NyxLauncher.Views"
             xmlns:themes="using:NyxLauncher.Themes">
    <!-- 首页直接站在窗口背景场景上：左下问候语，底部玻璃控制台承载版本选择与启动。 -->
    <Grid x:Name="Root" MinHeight="360" Padding="36,0,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 问候语随本地时段变化；文字颜色由背景取样器按画面亮度自动选择黑或白。 -->
        <StackPanel x:Name="Greeting" Grid.Row="1" Margin="4,0,0,20" Spacing="2" HorizontalAlignment="Left">
            <TextBlock x:Name="GreetingTitle" Style="{StaticResource DisplayTextStyle}" Text="你好" />
            <TextBlock x:Name="GreetingHint" FontSize="15" Opacity=".86" Text="选择版本，开始冒险" />
        </StackPanel>

        <!-- 底部控制台：版本选择器、启动进度与主操作始终固定尺寸，宽度随窗口在上限内变化。 -->
        <Border x:Name="Deck" Grid.Row="2" HorizontalAlignment="Left" MaxWidth="880" Padding="12"
                CornerRadius="{StaticResource SheetCornerRadius}"
                Background="{ThemeResource DeckGlassBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="SelectorHost" Height="56" HorizontalAlignment="Stretch">
                    <ComboBox x:Name="VersionList" MinWidth="0" Height="56" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Padding="12,0,10,0"
                              Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}"
                              CornerRadius="{StaticResource CardCornerRadius}"
                              PlaceholderText="请先安装游戏" SelectionChanged="Version_SelectionChanged"
                              AutomationProperties.Name="游戏版本">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="11" MinWidth="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:VersionIcon Version="{Binding}" Width="30" Height="30" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LaunchDetail}" FontSize="12"
                                                   Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid x:Name="LaunchProgress" Opacity="0" Visibility="Collapsed" ColumnSpacing="12" Padding="6,0" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ProgressTranslation" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StageLabel" FontSize="13" Foreground="{ThemeResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ProgressPercent" Grid.Column="1" FontSize="13" Foreground="{ThemeResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <ProgressBar x:Name="StageProgress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                     Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" CornerRadius="3"
                                     Foreground="{ThemeResource SecondaryBrush}" Background="{ThemeResource TintBrush}"
                                     AutomationProperties.Name="启动进度" />
                    </Grid>
                </Grid>

                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="ManageButton" Click="Manage_Click" Width="56" Height="56" Padding="0" VerticalAlignment="Center"
                            CornerRadius="{StaticResource CardCornerRadius}" ToolTipService.ToolTip="版本管理"
                            AutomationProperties.Name="管理所选版本">
                        <FontIcon x:Name="ManageIcon" Glyph="&#xE8F1;" FontSize="18" />
                    </Button>
                    <Button x:Name="LaunchButton" Click="Launch_Click" Width="196" Height="56" Padding="0"
                            VerticalAlignment="Center" Style="{StaticResource DeepButtonStyle}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            AutomationProperties.Name="启动游戏">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon x:Name="LaunchIcon" Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentButtonForeground}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="Status" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,16"
                 MaxWidth="620" IsClosable="True" Background="{ThemeResource MenuSurfaceBrush}"
                 BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}"
                 themes:ContrastScope.IsExcluded="True" />
    </Grid>
</UserControl>
