<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <Border CornerRadius="8" Background="#DDE8CD">
            <Grid Height="250">
                <Image Source="ms-appx:///Assets/Landscape.svg" Stretch="UniformToFill" />
                <TextBlock Text="我的世界" Margin="24" VerticalAlignment="Top"
                           FontSize="28" FontWeight="SemiBold" Foreground="#233F31" />
            </Grid>
        </Border>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="VersionList" FontSize="15" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      SelectionChanged="Version_SelectionChanged" DisplayMemberPath="Name" PlaceholderText="请先安装游戏" AutomationProperties.Name="游戏版本" />
            <Button x:Name="LaunchButton" Grid.Column="1" Click="Launch_Click" VerticalAlignment="Center" Padding="22,11"
                    Style="{StaticResource DeepButtonStyle}" AutomationProperties.Name="启动游戏">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="LaunchIcon" Glyph="&#xE768;" FontSize="16" />
                    <TextBlock x:Name="LaunchLabel" Text="启动游戏" FontSize="16" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock x:Name="CurrentAccount" Text="请先添加账户" FontSize="12" Foreground="#6B7A70" />
        <InfoBar x:Name="Status" IsClosable="True" />
    </StackPanel>
</UserControl>
