<UserControl x:Class="NyxLauncher.Views.MemorySettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource CardStyle}" Padding="24">
  <StackPanel Spacing="16">
   <TextBlock Text="内存分配" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel>
    <RadioButton x:Name="Automatic" Content="自动分配" Checked="Mode_Changed"/>
    <RadioButton x:Name="Manual" Content="手动分配" Checked="Mode_Changed"/>
   </StackPanel>
   <Slider x:Name="Allocation" Minimum="512" Maximum="4096" StepFrequency="256" ValueChanged="Allocation_Changed" AutomationProperties.Name="游戏分配内存"/>
   <Grid Height="20" CornerRadius="6" Background="{ThemeResource ShellBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="UsedColumn"/><ColumnDefinition x:Name="GameColumn"/><ColumnDefinition x:Name="FreeColumn"/></Grid.ColumnDefinitions>
    <Border Background="{ThemeResource MutedBrush}"/><Border Grid.Column="1" Background="{ThemeResource SecondaryBrush}"/>
   </Grid>
   <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="12" Height="12" Fill="{ThemeResource MutedBrush}"/><TextBlock x:Name="UsedLabel"/></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="12" Height="12" Fill="{ThemeResource SecondaryBrush}"/><TextBlock x:Name="GameLabel" TextWrapping="Wrap"/></StackPanel>
    <TextBlock x:Name="TotalLabel" Foreground="{ThemeResource MutedBrush}"/>
   </StackPanel>
   <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
  </StackPanel>
 </Border>
</UserControl>
