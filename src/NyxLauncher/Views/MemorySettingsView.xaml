<UserControl x:Class="NyxLauncher.Views.MemorySettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource CardStyle}" Padding="24">
  <StackPanel Spacing="16">
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="内存分配" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="ResetButton" Grid.Column="1" Content="恢复全局设置" Click="Reset_Click" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel>
    <RadioButton x:Name="Automatic" Content="自动分配" Checked="Mode_Changed"/>
    <RadioButton x:Name="Manual" Content="手动分配" Checked="Mode_Changed"/>
   </StackPanel>
   <Slider x:Name="Allocation" Minimum="512" Maximum="4096" StepFrequency="256" ValueChanged="Allocation_Changed" AutomationProperties.Name="游戏分配内存"/>
   <Grid Height="20" CornerRadius="6" Background="#EDF1EE">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="UsedColumn"/><ColumnDefinition x:Name="GameColumn"/><ColumnDefinition x:Name="FreeColumn"/></Grid.ColumnDefinitions>
    <Border Background="#697B70"/><Border Grid.Column="1" Background="#59AA7B"/>
   </Grid>
   <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="12" Height="12" Fill="#697B70"/><TextBlock x:Name="UsedLabel"/></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="12" Height="12" Fill="#59AA7B"/><TextBlock x:Name="GameLabel" TextWrapping="Wrap"/></StackPanel>
    <TextBlock x:Name="TotalLabel" Foreground="#6B7A70"/>
   </StackPanel>
   <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
  </StackPanel>
 </Border>
</UserControl>
