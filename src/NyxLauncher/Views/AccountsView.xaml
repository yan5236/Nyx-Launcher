<UserControl x:Class="NyxLauncher.Views.AccountsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Button x:Name="AddButton" HorizontalAlignment="Right" Style="{StaticResource DeepButtonStyle}" Click="Add_Click" AutomationProperties.Name="添加账户">
   <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="添加账户" Foreground="White"/></StackPanel>
  </Button>
  <InfoBar x:Name="Error" Grid.Row="1" Severity="Error" IsClosable="True"/>
  <Grid Grid.Row="2">
   <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
    <FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="#87928A"/>
    <TextBlock Text="目前还没有账户呢，点击右上角添加" Foreground="#6B7A70" TextAlignment="Center" TextWrapping="Wrap"/>
   </StackPanel>
   <ListView x:Name="AccountList" SelectionMode="Single" SelectionChanged="Account_SelectionChanged" IsItemClickEnabled="True" ItemClick="Account_Click" AutomationProperties.Name="账户列表">
    <ListView.ItemContainerStyle>
     <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
       <Setter.Value><ControlTemplate TargetType="ListViewItem">
        <ListViewItemPresenter ContentMargin="0" CornerRadius="6" HorizontalContentAlignment="Stretch"/>
       </ControlTemplate></Setter.Value>
      </Setter>
     </Style>
    </ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="views:AccountRow">
     <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
     <Grid ColumnSpacing="14" MinHeight="64" Padding="0,10,14,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="3" Height="26" CornerRadius="2" Background="#397450" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"/>
      <Image Grid.Column="1" Source="{x:Bind Avatar}" Width="40" Height="40"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
       <TextBlock Text="{x:Bind Name}" FontSize="17"/>
       <TextBlock Text="{x:Bind TypeLabel}" FontSize="12" Foreground="#6B7A70"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Click="RetryLogin_Click" Tag="{x:Bind Account}" Width="34" Height="34" Padding="0" CornerRadius="17"
               AutomationProperties.Name="{x:Bind RetryLabel}" ToolTipService.ToolTip="重试登录">
        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
       </Button>
       <Button Click="Delete_Click" Tag="{x:Bind Account}" Width="34" Height="34" Padding="0" CornerRadius="17"
               AutomationProperties.Name="{x:Bind DeleteLabel}" ToolTipService.ToolTip="删除账户">
        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
       </Button>
      </StackPanel>
     </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
 </Grid>
</UserControl>
