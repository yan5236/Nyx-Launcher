<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NyxLauncher.Views">
    <Grid>
    <Grid x:Name="CatalogPanel" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <SelectorBar x:Name="ContentSelector" SelectionChanged="ContentSelector_SelectionChanged"
                     AutomationProperties.Name="下载内容分类">
            <SelectorBarItem Text="游戏" Tag="game" IsSelected="True" />
            <SelectorBarItem Text="模组" Tag="mod" />
            <SelectorBarItem Text="整合包" Tag="modpack" />
            <SelectorBarItem Text="资源包" Tag="resourcepack" />
            <SelectorBarItem Text="数据包" Tag="datapack" />
            <SelectorBarItem Text="光影" Tag="shader" />
        </SelectorBar>
        <Grid Grid.Column="1">
            <SelectorBar x:Name="TaskSelector" SelectionChanged="TaskSelector_SelectionChanged" AutomationProperties.Name="下载任务分类">
                <SelectorBarItem Text="下载任务" />
            </SelectorBar>
            <InfoBadge x:Name="TaskBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,2,2,0" IsHitTestVisible="False" AutomationProperties.Name="有新下载任务" />
        </Grid>
        </Grid>

        <Grid x:Name="SearchControls" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索游戏版本" QueryIcon="Find"
                            FontSize="15" VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged"
                            AutomationProperties.Name="搜索下载内容" />
            <ComboBox x:Name="TypeFilter" Grid.Column="1" MinWidth="140" SelectedIndex="1"
                      FontSize="15" VerticalAlignment="Center"
                      SelectionChanged="TypeFilter_SelectionChanged"
                      AutomationProperties.Name="版本类型筛选">
                <ComboBoxItem Content="全部类型" />
                <ComboBoxItem Content="正式版" />
                <ComboBoxItem Content="快照版" />
                <ComboBoxItem Content="远古版" />
                <ComboBoxItem Content="愚人节版" />
            </ComboBox>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="2">
            <views:VersionLoadStatus x:Name="LoadStatus" Visibility="Collapsed" />
            <!-- 将滚动条移入页面右侧留白，等量内边距保持卡片与搜索栏对齐。 -->
            <ListView x:Name="EntryList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="EntryList_ItemClick"
                      Margin="0,0,-20,0" Padding="0,0,20,0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="下载内容列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="14" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:DownloadEntry">
                        <Grid ColumnSpacing="14" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#E0EBD6" Width="40" Height="40" CornerRadius="6"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="#397450" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ReleaseDate}" FontSize="13" Foreground="#6B7A70" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#F0F3EC" CornerRadius="4"
                                    Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Kind}" FontSize="12" Foreground="#5B6B60" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint" Text="没有匹配的内容" FontSize="15" Foreground="#6B7A70"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
        <views:ResourceCatalogView x:Name="ResourcesContent" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <views:DownloadTasksView x:Name="TasksContent" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
    <views:InstallationView x:Name="InstallationContent" Visibility="Collapsed" />
    <views:ModDetailsView x:Name="ModDetailsContent" Visibility="Collapsed" />
    </Grid>
</UserControl>
