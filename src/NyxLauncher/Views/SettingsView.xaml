<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <SelectorBar x:Name="SettingsTabs" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="设置分类">
   <SelectorBarItem Text="通用" Tag="general" IsSelected="True" />
   <SelectorBarItem Text="启动" Tag="launch" />
   <SelectorBarItem Text="Java" Tag="java" />
   <SelectorBarItem Text="下载" Tag="download" />
   <SelectorBarItem x:Name="AboutTab" Text="关于" Tag="about" />
  </SelectorBar>
  <views:TabContentPanel x:Name="TabBody" Grid.Row="1">
      <ScrollViewer x:Name="GeneralPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Margin="0,0,16,0">
       <Border Style="{StaticResource CardStyle}">
        <views:ScrollSafeComboBox x:Name="Isolation" Header="版本隔离" HorizontalAlignment="Stretch"
                  SelectionChanged="Source_SelectionChanged" AutomationProperties.Name="版本隔离">
         <ComboBoxItem Content="关闭" />
         <ComboBoxItem Content="隔离可安装 Mod 的版本" />
         <ComboBoxItem Content="隔离非正式版" />
         <ComboBoxItem Content="隔离可安装 Mod 的版本与非正式版" />
         <ComboBoxItem Content="隔离所有版本" />
        </views:ScrollSafeComboBox>
       </Border>
       <views:AppearanceSettingsView />
       <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
         <TextBlock Text="联机模块" Style="{StaticResource SubtitleTextBlockStyle}"/>
         <TextBlock x:Name="ModulePath" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
         <StackPanel Spacing="8" HorizontalAlignment="Left">
          <Button x:Name="DownloadModule" Content="下载到指定目录" Click="DownloadModule_Click"/>
          <Button x:Name="SelectModule" Content="选择已安装的模块" Click="SelectModule_Click"/>
          <Button x:Name="ExportModuleLog" Content="导出联机日志" Click="ExportModuleLog_Click"/>
         </StackPanel>
         <InfoBar x:Name="ModuleFeedback" IsClosable="True"/>
        </StackPanel>
       </Border>
      </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DownloadPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Spacing="16" Margin="0,0,16,0">
       <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="16">
         <views:ScrollSafeComboBox x:Name="FileSource" Header="文件下载源" HorizontalAlignment="Stretch"
           SelectionChanged="Source_SelectionChanged" AutomationProperties.Name="文件下载源">
          <ComboBoxItem Content="尽量使用镜像源" /><ComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" /><ComboBoxItem Content="尽量使用官方源" />
         </views:ScrollSafeComboBox>
         <views:ScrollSafeComboBox x:Name="VersionSource" Header="版本列表源" HorizontalAlignment="Stretch"
           SelectionChanged="Source_SelectionChanged" AutomationProperties.Name="版本列表源">
          <ComboBoxItem Content="尽量使用镜像源" /><ComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" /><ComboBoxItem Content="尽量使用官方源" />
         </views:ScrollSafeComboBox>
         <TextBlock Text="优先源失败时自动尝试另一来源；混合策略在官方加载超过 3 秒时同时尝试镜像。" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
        </StackPanel>
       </Border>
       <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
         <TextBlock x:Name="ParallelLabel" />
         <Slider x:Name="ParallelDownloads" Minimum="1" Maximum="64" StepFrequency="1"
           ValueChanged="Limit_ValueChanged" AutomationProperties.Name="并行下载文件数" />
         <TextBlock x:Name="ConnectionsLabel" />
         <Slider x:Name="Connections" Minimum="1" Maximum="64" StepFrequency="1"
           ValueChanged="Limit_ValueChanged" AutomationProperties.Name="最大下载线程数" />
         <TextBlock x:Name="SpeedLabel" />
         <Slider x:Name="Speed" Minimum="0" Maximum="100" StepFrequency="1"
           ValueChanged="Limit_ValueChanged" AutomationProperties.Name="下载速率限制，零为不限速" />
         <TextBlock Text="并行文件数、线程数和限速由普通文件与 Minecraft 资源共用；修改后在下一批下载或空闲后继续任务时生效。" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
        </StackPanel>
       </Border>
      </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="LaunchPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16" Margin="0,0,16,0"><views:MemorySettingsView x:Name="MemoryPanel" VerticalAlignment="Top"/><views:AdvancedLaunchSettingsView x:Name="AdvancedPanel"/></StackPanel></ScrollViewer>
      <views:JavaSettingsView x:Name="JavaPanel" Visibility="Collapsed"/>
      <views:AboutView x:Name="AboutPanel" x:Load="False" Visibility="Collapsed"/>
  </views:TabContentPanel>
  <InfoBar x:Name="SaveError" Grid.Row="2" Severity="Error" IsClosable="False" />
 </Grid>
</UserControl>
