<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.VersionDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Click="Back_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="返回版本列表">
                    <FontIcon Glyph="&#xE72B;" FontSize="18" />
                </Button>
                <TextBlock x:Name="VersionName" Grid.Column="1" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Click="Delete_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="删除版本" AutomationProperties.Name="删除此版本">
                    <Image Source="ms-appx:///Assets/Delete.svg" Width="20" Height="20" />
                </Button>
            </Grid>
            <InfoBar x:Name="Status" Severity="Error" IsClosable="False" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="VersionInfo" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="版本文件夹" Foreground="#6B7A70" />
                    <TextBlock x:Name="VersionPath" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <Button Content="打开文件夹" Click="OpenFolder_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
