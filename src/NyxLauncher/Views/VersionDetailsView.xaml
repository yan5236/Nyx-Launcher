<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.VersionDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NyxLauncher.Views">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center" AutomationProperties.Name="返回版本列表">
                <FontIcon Glyph="&#xE72B;" FontSize="20"/>
            </Button>
            <views:VersionIcon x:Name="HeaderIcon" Grid.Column="1" Width="48" Height="48"/>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="VersionName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VersionInfo" FontSize="13" Foreground="#6B7A70" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="版本详情分类">
            <SelectorBarItem Text="基础" IsSelected="True"/>
            <SelectorBarItem Text="模组管理"/>
            <SelectorBarItem Text="游戏设置"/>
            <SelectorBarItem Text="导出"/>
        </SelectorBar>
        <InfoBar x:Name="Status" Grid.Row="2" Severity="Error" IsClosable="False"/>
        <ScrollViewer x:Name="BasicPanel" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="0,0,4,0">
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <Grid RowSpacing="16" ColumnSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="版本名" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameInput" Grid.Column="1" MaxLength="128" VerticalAlignment="Center" KeyDown="NameInput_KeyDown" AutomationProperties.Name="版本名"/>
                        <Button x:Name="RenameButton" Grid.Column="2" Content="保存" Click="Rename_Click" VerticalAlignment="Center" AutomationProperties.Name="保存版本名"/>
                        <TextBlock Grid.Row="1" Text="图标" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                            <views:VersionIcon x:Name="PreviewIcon" Width="40" Height="40"/>
                            <Button x:Name="ChangeIconButton" Content="修改" Click="ChangeIcon_Click" VerticalAlignment="Center" AutomationProperties.Name="修改版本图标"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Rectangle Height="1" Fill="#DDE5DF"/>
                <StackPanel Spacing="10">
                    <TextBlock Text="快速打开" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Button Tag="version" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" AutomationProperties.Name="打开版本文件夹">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="18"/><TextBlock Text="版本文件夹"/></StackPanel>
                    </Button>
                    <Button Tag="mods" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" AutomationProperties.Name="打开模组文件夹">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEA86;" FontSize="18"/><TextBlock Text="模组文件夹"/></StackPanel>
                    </Button>
                    <Button Tag="saves" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" AutomationProperties.Name="打开存档文件夹">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE909;" FontSize="18"/><TextBlock Text="存档文件夹"/></StackPanel>
                    </Button>
                    <Button Tag="screenshots" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" AutomationProperties.Name="打开截图文件夹">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE722;" FontSize="18"/><TextBlock Text="截图文件夹"/></StackPanel>
                    </Button>
                </StackPanel>
                <Rectangle Height="1" Fill="#DDE5DF"/>
                <StackPanel Spacing="10">
                    <TextBlock Text="危险区" FontSize="16" FontWeight="SemiBold" Foreground="#A4262C"/>
                    <Border Style="{StaticResource CardStyle}" BorderBrush="#E3B4B1" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="删除版本" FontWeight="SemiBold"/>
                                <TextBlock Text="将版本文件夹及其中的独立存档、模组和设置移入回收站。" Foreground="#6B7A70" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="删除版本" Click="Delete_Click" Foreground="#A4262C" VerticalAlignment="Center" AutomationProperties.Name="删除当前版本"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
