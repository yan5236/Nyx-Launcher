<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.DownloadTasksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="using:NyxLauncher.Services">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
   <ComboBox x:Name="Filter" SelectedIndex="0" MinWidth="130" SelectionChanged="Filter_Changed" AutomationProperties.Name="下载状态筛选">
    <ComboBoxItem Content="全部状态"/><ComboBoxItem Content="正在下载"/><ComboBoxItem Content="已暂停"/>
    <ComboBoxItem Content="已完成"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="已取消"/>
   </ComboBox>
   <Button Content="创建下载" Click="Create_Click" />
  </StackPanel>
  <ListView x:Name="TaskList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="下载任务列表">
   <ListView.ItemContainerStyle>
    <Style TargetType="ListViewItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
     <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
   </ListView.ItemContainerStyle>
   <ListView.ItemTemplate>
    <DataTemplate x:DataType="services:DownloadTaskItem">
     <Border Style="{StaticResource CardStyle}">
      <Grid ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" CornerRadius="6" Background="#E0EBD6" VerticalAlignment="Center">
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="#397450"/>
       </Border>
       <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="#6B7A70" TextTrimming="CharacterEllipsis"
                   ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
        <Grid ColumnSpacing="10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
         <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="5" VerticalAlignment="Center" Foreground="#397450"/>
         <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Tag="{x:Bind}" Click="Folder_Click" Background="Transparent" BorderThickness="0" Padding="8"
                AutomationProperties.Name="打开下载目录" ToolTipService.ToolTip="打开文件夹"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button>
        <Button Tag="{x:Bind}" Click="Pause_Click" IsEnabled="{x:Bind CanPause, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind PauseLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PauseLabel, Mode=OneWay}"
                Background="Transparent" BorderThickness="0" Padding="8">
         <FontIcon Glyph="{x:Bind PauseGlyph, Mode=OneWay}" FontSize="16"/>
        </Button>
        <Button Tag="{x:Bind}" Click="Dismiss_Click" IsEnabled="{x:Bind CanDismiss, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind DismissLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DismissLabel, Mode=OneWay}"
                Background="Transparent" BorderThickness="0" Padding="8">
         <FontIcon Glyph="{x:Bind DismissGlyph, Mode=OneWay}" FontSize="16"/>
        </Button>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
  <TextBlock x:Name="Empty" Grid.Row="1" Text="暂无下载任务" Foreground="#6B7A70" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  <InfoBar x:Name="Error" Grid.Row="2" Severity="Error" IsClosable="True" />
 </Grid>
</UserControl>
