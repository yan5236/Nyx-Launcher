<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="NyxLauncher.Views.GameFolderDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择文件夹">
    <Grid x:Name="DialogContent" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="选择文件夹" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="10"
                    AutomationProperties.Name="关闭文件夹选择" ToolTipService.ToolTip="关闭"><FontIcon Glyph="&#xE711;" FontSize="18" /></Button>
        </Grid>
        <InfoBar x:Name="Status" Grid.Row="1" Severity="Error" IsClosable="False" />
        <Grid Grid.Row="2">
            <ListView x:Name="Folders" SelectionMode="None" IsTabStop="False" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="游戏文件夹列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,10" /><Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Click="Select_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="14,16"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding}" />
                                </Button>
                                <Button Grid.Column="1" Click="Remove_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="10"
                                        Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="移除文件夹" ToolTipService.ToolTip="从列表移除，不删除文件">
                                    <Image Source="ms-appx:///Assets/Delete.svg" Width="20" Height="20" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" Text="还没有添加文件夹" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" Margin="0,30,0,0" />
        </Grid>
        <Button x:Name="AddButton" Grid.Row="3" Content="添加文件夹" Click="Add_Click" HorizontalAlignment="Left" />
    </Grid>
</ContentDialog>
