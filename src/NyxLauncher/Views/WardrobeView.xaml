<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.WardrobeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views">
 <Grid RowSpacing="16" ColumnSpacing="24" Padding="0,0,0,20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <views:ScrollSafeComboBox x:Name="AccountPicker" MinHeight="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
    PlaceholderText="选择微软账户" AutomationProperties.Name="衣柜账户" SelectionChanged="Account_Changed">
   <ComboBox.ItemTemplate><DataTemplate>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <views:AccountAvatar Account="{Binding}" Width="32" Height="32"/>
     <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </StackPanel>
   </DataTemplate></ComboBox.ItemTemplate>
  </views:ScrollSafeComboBox>
  <Grid Grid.Column="1" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Search" PlaceholderText="搜索" VerticalAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="搜索皮肤或披风"/>
   <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" VerticalAlignment="Center" Click="Refresh_Click"/>
   <Button x:Name="UploadButton" Grid.Column="2" Content="上传" Style="{StaticResource DeepButtonStyle}" VerticalAlignment="Center" Click="Upload_Click"/>
  </Grid>
  <Grid Grid.Row="1" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{ThemeResource TintBrush}" CornerRadius="12" MinHeight="220">
    <views:SkinPreview x:Name="Preview"/>
   </Border>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
    <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" ToolTipService.ToolTip="暂停或继续走动"/>
    <Button Content="−" Click="ZoomOut_Click" AutomationProperties.Name="缩小" ToolTipService.ToolTip="缩小"/>
    <Button Content="＋" Click="ZoomIn_Click" AutomationProperties.Name="放大" ToolTipService.ToolTip="放大"/>
    <Button Content="复位" Click="Reset_Click" ToolTipService.ToolTip="恢复人物右前方视角"/>
   </StackPanel>
   <Button x:Name="ApplyButton" Grid.Row="2" Content="应用" HorizontalAlignment="Stretch" Style="{StaticResource DeepButtonStyle}" Click="Apply_Click" IsEnabled="False"/>
  </Grid>
  <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <SelectorBar x:Name="CategoryTabs" SelectionChanged="Tab_Changed">
    <SelectorBarItem x:Name="SkinsTab" Text="皮肤" IsSelected="True"/>
    <SelectorBarItem x:Name="CapesTab" Text="披风"/>
   </SelectorBar>
   <views:TabContentPanel x:Name="TabBody" Grid.Row="1">
       <GridView x:Name="Cards" SelectionMode="Single" SelectionChanged="Card_Changed" HorizontalAlignment="Stretch">
        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
        <GridView.ItemTemplate><DataTemplate>
         <Grid Width="144" Height="208" Background="{ThemeResource TintBrush}" CornerRadius="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="5"/>
          <Button Content="＋" Visibility="{Binding UploadVisibility}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Upload_Click" AutomationProperties.Name="上传新皮肤"/>
          <Button Content="⋯" Visibility="{Binding MenuVisibility}" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top"
           Margin="4" Padding="8,0" Click="SkinMenu_Click" AutomationProperties.Name="皮肤菜单"/>
          <TextBlock Grid.Row="1" Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="136" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </DataTemplate></GridView.ItemTemplate>
       </GridView>
       <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="False"/>
        <TextBlock Text="正在加载…" HorizontalAlignment="Center"/>
       </StackPanel>
   </views:TabContentPanel>
  </Grid>
  <InfoBar x:Name="Status" Grid.Row="2" Grid.ColumnSpan="2" IsClosable="True"/>
  <InfoBar x:Name="SuccessToast" Grid.RowSpan="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
    MaxWidth="380" Severity="Success" IsClosable="True"/>
 </Grid>
</UserControl>
