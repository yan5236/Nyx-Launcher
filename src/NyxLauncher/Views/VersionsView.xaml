<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <Button Content="导入版本" IsEnabled="False" HorizontalAlignment="Right" />
        <ListView SelectionMode="Single" SelectedIndex="0" AutomationProperties.Name="已安装版本示例">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="14" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListViewItem AutomationProperties.Name="1.21.4 原版">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#E0EBD6" Width="36" Height="36" CornerRadius="6"><FontIcon Glyph="&#xE80A;" Foreground="#397450" FontSize="20" /></Border>
                    <TextBlock Grid.Column="1" Text="1.21.4" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="原版" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="1.21.4 Fabric">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#EEE8D9" Width="36" Height="36" CornerRadius="6"><FontIcon Glyph="&#xE8A5;" Foreground="#8A713C" FontSize="20" /></Border>
                    <TextBlock Grid.Column="1" Text="1.21.4" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Fabric" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="1.20.1 Forge">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#E5E6EF" Width="36" Height="36" CornerRadius="6"><FontIcon Glyph="&#xE90F;" Foreground="#696C90" FontSize="20" /></Border>
                    <TextBlock Grid.Column="1" Text="1.20.1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Forge" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
        </ListView>
        <Button Content="打开文件夹" IsEnabled="False" />
    </StackPanel>
</UserControl>
