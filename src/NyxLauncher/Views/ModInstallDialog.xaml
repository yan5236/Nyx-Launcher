<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="NyxLauncher.Views.ModInstallDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 PrimaryButtonText="选择文件夹下载" PrimaryButtonClick="ChooseDirectory_Click"
 CloseButtonText="取消" DefaultButton="Close">
 <ContentDialog.TitleTemplate>
  <DataTemplate>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Button Click="Back_Click" Visibility="{Binding BackVisibility}" ToolTipService.ToolTip="返回上一步" AutomationProperties.Name="返回上一步">
     <FontIcon Glyph="&#xE72B;" FontSize="16"/>
    </Button>
    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </StackPanel>
  </DataTemplate>
 </ContentDialog.TitleTemplate>
 <Grid x:Name="DialogContent" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="FileName" TextWrapping="Wrap" FontWeight="SemiBold"/>
  <Grid Grid.Row="1">
   <ListView x:Name="Targets" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Target_Click"
    AutomationProperties.Name="兼容的已安装游戏版本">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource CardListItemStyle}">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/>
     <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="{ThemeResource CardBrush}"/>
     <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
     <Setter Property="CornerRadius" Value="6"/>
    </Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Grid ColumnSpacing="12" AutomationProperties.Name="{Binding AccessibleName}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image Loaded="Icon_Loaded" DataContextChanged="Icon_DataContextChanged" Width="32" Height="32"/>
      <StackPanel Grid.Column="1" Spacing="4">
       <TextBlock Text="{Binding Version.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Version.Detail}" Visibility="{Binding DetailVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ModsPath}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      </StackPanel>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyHint" Text="当前游戏目录没有兼容版本，可选择文件夹下载。"
    Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
  </Grid>
  <InfoBar x:Name="Error" Grid.Row="2" Severity="Error" IsOpen="False"/>
 </Grid>
</ContentDialog>
