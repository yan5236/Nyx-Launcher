<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.VersionIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E0EBD6" CornerRadius="8">
        <Grid>
            <FontIcon x:Name="DefaultIcon" Glyph="&#xE7FC;" FontSize="26" Foreground="#397450" />
            <Image x:Name="CustomIcon" Stretch="Uniform" Margin="3" />
        </Grid>
    </Border>
</UserControl>
