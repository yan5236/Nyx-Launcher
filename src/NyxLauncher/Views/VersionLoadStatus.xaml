<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="NyxLauncher.Views.VersionLoadStatus"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Storyboard x:Name="Spin">
   <DoubleAnimation Storyboard.TargetName="RingRotation" Storyboard.TargetProperty="Angle"
     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
  </Storyboard>
  <Storyboard x:Name="Failure">
   <ColorAnimation Storyboard.TargetName="RingBrush" Storyboard.TargetProperty="Color"
     To="#C42B36" Duration="0:0:0.2" EnableDependentAnimation="True" />
   <DoubleAnimation Storyboard.TargetName="Arc" Storyboard.TargetProperty="Opacity"
     To="0" BeginTime="0:0:0.2" Duration="0:0:0.2" />
   <DoubleAnimation Storyboard.TargetName="Cross" Storyboard.TargetProperty="Opacity"
     From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.25" />
   <DoubleAnimation Storyboard.TargetName="CrossScale" Storyboard.TargetProperty="ScaleX"
     From="0.55" To="1" BeginTime="0:0:0.2" Duration="0:0:0.3">
    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
   </DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="CrossScale" Storyboard.TargetProperty="ScaleY"
     From="0.55" To="1" BeginTime="0:0:0.2" Duration="0:0:0.3">
    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
   </DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="ErrorDetails" Storyboard.TargetProperty="Opacity"
     From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.2" />
  </Storyboard>
 </UserControl.Resources>
 <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
  <Grid Width="64" Height="64" HorizontalAlignment="Center" AutomationProperties.Name="加载状态">
   <Path x:Name="Arc" Data="M 32,6 A 26,26 0 1 1 6,32" StrokeThickness="4"
     StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
     Width="64" Height="64">
    <Path.Stroke><SolidColorBrush x:Name="RingBrush" Color="#397450" /></Path.Stroke>
    <Path.RenderTransform><RotateTransform x:Name="RingRotation" /></Path.RenderTransform>
   </Path>
   <Path x:Name="Cross" Data="M 17,17 L 47,47 M 47,17 L 17,47" Stroke="#C42B36"
     StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
     Width="64" Height="64" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Path.RenderTransform><ScaleTransform x:Name="CrossScale" /></Path.RenderTransform>
   </Path>
  </Grid>
  <TextBlock x:Name="StatusText" Text="正在加载" FontSize="18" HorizontalAlignment="Center"
    AutomationProperties.LiveSetting="Polite" />
  <StackPanel x:Name="ErrorDetails" Spacing="16" Visibility="Collapsed">
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#6B7A70"
     IsTextSelectionEnabled="True" MaxHeight="180" />
   <Button Content="重试" HorizontalAlignment="Center" Click="Retry_Click" />
  </StackPanel>
 </StackPanel>
</UserControl>
