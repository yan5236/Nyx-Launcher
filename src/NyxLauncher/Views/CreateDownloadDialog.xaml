<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="NyxLauncher.Views.CreateDownloadDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="创建下载" PrimaryButtonText="取消" SecondaryButtonText="下载"
 SecondaryButtonStyle="{StaticResource DeepButtonStyle}"
 DefaultButton="Secondary" SecondaryButtonClick="Download_Click">
 <ContentDialog.Resources>
  <SolidColorBrush x:Key="AccentButtonBackground" Color="#28563B" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#346C4B" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#20452F" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#28563B" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#346C4B" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#20452F" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
 </ContentDialog.Resources>
 <StackPanel Spacing="18" MinWidth="350">
  <TextBox x:Name="DownloadUrl" Header="下载链接" PlaceholderText="https://…/文件名.zip"
           AutomationProperties.Name="下载链接" />
  <StackPanel Spacing="8">
   <TextBlock Text="下载目录" />
   <Button x:Name="DirectoryButton" Click="ChooseDirectory_Click" HorizontalAlignment="Stretch"
           HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择下载目录">
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="DirectoryText" Text="选择文件夹" TextTrimming="CharacterEllipsis" />
     <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="16" />
    </Grid>
   </Button>
  </StackPanel>
  <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
 </StackPanel>
</ContentDialog>
