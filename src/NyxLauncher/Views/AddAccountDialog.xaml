<ContentDialog x:Class="NyxLauncher.Views.AddAccountDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:NyxLauncher.Views"
 AllowDrop="True" DragOver="External_DragOver" Drop="External_Drop" PrimaryButtonText="取消" PrimaryButtonClick="Primary_Click" SecondaryButtonClick="Confirm_Click"
 SecondaryButtonStyle="{StaticResource DeepButtonStyle}" AutomationProperties.Name="添加账户">
 <ContentDialog.Title>
  <StackPanel Orientation="Horizontal" Spacing="10">
   <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8"
           AutomationProperties.Name="返回账户类型" ToolTipService.ToolTip="返回">
    <FontIcon Glyph="&#xE72B;" FontSize="20"/>
   </Button>
   <TextBlock x:Name="DialogTitle" Text="添加账户" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </StackPanel>
 </ContentDialog.Title>
 <StackPanel x:Name="StepContent" Spacing="16" MinWidth="340" MinHeight="210">
  <StackPanel.RenderTransform><TranslateTransform x:Name="StepTranslation"/></StackPanel.RenderTransform>
  <StackPanel x:Name="Types" Spacing="10">
   <InfoBar x:Name="RegionNotice" Severity="Informational" IsOpen="False" IsClosable="False"
            Title="首次使用仅支持微软账户"
            Message="添加微软账户后，离线与外置账户即可使用。"/>
   <Button x:Name="MicrosoftButton" Click="Microsoft_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="微软登录">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="24" Height="24" RowSpacing="3" ColumnSpacing="3">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Rectangle Fill="{ThemeResource SecondaryBrush}"/><Rectangle Grid.Column="1" Fill="{ThemeResource SecondaryBrush}"/>
      <Rectangle Grid.Row="1" Fill="{ThemeResource SecondaryBrush}"/><Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource SecondaryBrush}"/>
     </Grid>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="微软登录"/><TextBlock x:Name="MicrosoftHint" Text="在系统浏览器中登录" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
    </Grid>
   </Button>
   <Button x:Name="OfflineButton" Click="Offline_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="离线账号">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource SecondaryBrush}"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="离线账户"/><TextBlock Text="使用本地账户名称启动游戏" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
    </Grid>
   </Button>
   <Button x:Name="ExternalButton" Click="External_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="外置登录">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{ThemeResource SecondaryBrush}"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="外置登录"/><TextBlock Text="使用皮肤站账户和角色登录" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
    </Grid>
   </Button>
  </StackPanel>
  <TextBox x:Name="AccountName" Visibility="Collapsed" Header="请输入账户名称" PlaceholderText="1–16 个英文字母、数字或下划线" MaxLength="16" AutomationProperties.Name="账户名称"/>
  <Grid x:Name="LoginProgress" MinHeight="210" Visibility="Collapsed">
   <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
    <ProgressRing x:Name="LoginRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center"/>
    <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" TextAlignment="Center"/>
    <TextBlock x:Name="BrowserHint" Text="若浏览器未打开，请通过下面的按钮重试打开；也可复制链接，在本机浏览器中继续验证。"
               FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
   </StackPanel>
  </Grid>
  <ContentControl x:Name="ExternalPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" MaxWidth="460"><StackPanel Spacing="12">
   <Grid x:Name="ServerHeader">
    <TextBlock Text="认证服务器" VerticalAlignment="Center"/>
    <Button Content="创建认证服务器" Click="CreateServer_Click" HorizontalAlignment="Right" Style="{StaticResource DeepButtonStyle}"/>
   </Grid>
   <ListView x:Name="ServerList" IsItemClickEnabled="True" ItemClick="Server_Click" MaxHeight="220">
    <ListView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Url}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="1" Tag="{Binding}" Click="EditServer_Click" AutomationProperties.Name="编辑认证服务器" ToolTipService.ToolTip="编辑"><FontIcon Glyph="&#xE70F;" FontSize="14"/></Button>
     <Button Grid.Column="2" Tag="{Binding}" Click="DeleteServer_Click" AutomationProperties.Name="删除认证服务器" ToolTipService.ToolTip="删除"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
    </Grid></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel x:Name="CreateServerPanel" Visibility="Collapsed" Spacing="10">
    <TextBox x:Name="ServerName" Header="显示名称（可选）"/>
    <TextBox x:Name="ServerUrl" Header="认证服务器链接" PlaceholderText="https://example.com/api/yggdrasil"/>
    <TextBlock Text="修改或删除服务器目录项不会更改已有账户的认证地址。" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="CredentialsPanel" Visibility="Collapsed" Spacing="10">
    <TextBlock x:Name="ServerLabel" TextWrapping="Wrap"/>
    <TextBox x:Name="ExternalUsername" Header="账户" PlaceholderText="皮肤站邮箱或账户"/>
    <PasswordBox x:Name="ExternalPassword" Header="密码"/>

   </StackPanel>
   <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed" Spacing="10">
    <TextBlock Text="选择角色"/>
    <ListView x:Name="ProfileList" SelectionMode="Single" MaxHeight="220" AutomationProperties.Name="选择角色">
     <ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12" Padding="6">
      <views:AccountAvatar ProfileId="{Binding Id}" AuthServer="{Binding ServerUrl}" Width="40" Height="40"/>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="16"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </StackPanel>
   <ProgressRing x:Name="ExternalRing" IsActive="False" Visibility="Collapsed" Width="28" Height="28"/>
  </StackPanel></ContentControl>
  <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
 </StackPanel>
</ContentDialog>
