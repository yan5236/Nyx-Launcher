<ContentDialog x:Class="NyxLauncher.Views.AddAccountDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 PrimaryButtonText="取消" SecondaryButtonClick="Confirm_Click"
 SecondaryButtonStyle="{StaticResource DeepButtonStyle}" AutomationProperties.Name="添加账户">
 <ContentDialog.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Themes/AccentButtonResources.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </ContentDialog.Resources>
 <ContentDialog.Title>
  <StackPanel Orientation="Horizontal" Spacing="10">
   <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8"
           AutomationProperties.Name="返回账户类型" ToolTipService.ToolTip="返回">
    <FontIcon Glyph="&#xE72B;" FontSize="20"/>
   </Button>
   <TextBlock x:Name="DialogTitle" Text="添加账户" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </StackPanel>
 </ContentDialog.Title>
 <StackPanel x:Name="StepContent" Spacing="16" MinWidth="340" MinHeight="210">
  <StackPanel.RenderTransform><TranslateTransform x:Name="StepTranslation"/></StackPanel.RenderTransform>
  <StackPanel x:Name="Types" Spacing="10">
   <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="微软账号，暂不可用">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="24" Height="24" RowSpacing="3" ColumnSpacing="3">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Rectangle Fill="#397450"/><Rectangle Grid.Column="1" Fill="#397450"/>
      <Rectangle Grid.Row="1" Fill="#397450"/><Rectangle Grid.Row="1" Grid.Column="1" Fill="#397450"/>
     </Grid>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="微软登录"/><TextBlock Text="等待微软 API 申请完成" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
   <Button x:Name="OfflineButton" Click="Offline_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="离线账号">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="#397450"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="离线账户"/><TextBlock Text="使用本地账户名称启动游戏" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
   <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="外置登录，暂不可用">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="#397450"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="外置登录"/><TextBlock Text="暂未接入" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
  </StackPanel>
  <TextBox x:Name="AccountName" Visibility="Collapsed" Header="请输入账户名称" PlaceholderText="1–16 个英文字母、数字或下划线" MaxLength="16" AutomationProperties.Name="账户名称"/>
  <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
 </StackPanel>
</ContentDialog>
