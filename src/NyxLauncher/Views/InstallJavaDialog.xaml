<ContentDialog x:Class="NyxLauncher.Views.InstallJavaDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="using:NyxLauncher.Services"
 PrimaryButtonText="取消" SecondaryButtonText="" IsSecondaryButtonEnabled="False" SecondaryButtonClick="Install_Click" SecondaryButtonStyle="{StaticResource DeepButtonStyle}"
 DefaultButton="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="安装 Java">
 <ContentDialog.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="ms-appx:///Themes/AccentButtonResources.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentDialog.Resources>
 <StackPanel x:Name="DialogContent" Spacing="20" MinWidth="340">
  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Visibility="Collapsed" Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="返回上一步"><FontIcon Glyph="&#xE72B;" FontSize="18"/></Button>
   <TextBlock x:Name="DialogTitle" Grid.Column="1" Text="选择 Java 主版本" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Grid.Column="2" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="关闭 Java 安装"><FontIcon Glyph="&#xE711;" FontSize="16"/></Button>
  </Grid>
 <StackPanel x:Name="StepContent" Spacing="14" MinWidth="340" MinHeight="260">
  <StackPanel.RenderTransform><TranslateTransform x:Name="StepTranslation"/></StackPanel.RenderTransform>
  <StackPanel x:Name="MajorPanel" Spacing="10">
   <Button x:Name="Major8" Content="Java 8" Tag="8" Click="Major_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52" FontWeight="SemiBold"/>
   <Button Content="Java 17" Tag="17" Click="Major_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52" FontWeight="SemiBold"/>
   <Button Content="Java 21" Tag="21" Click="Major_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52" FontWeight="SemiBold"/>
   <Button Content="Java 25" Tag="25" Click="Major_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52" FontWeight="SemiBold"/>
  </StackPanel>
  <StackPanel x:Name="ChannelPanel" Spacing="10" Visibility="Collapsed">
   <Button Tag="Mojang" Click="Channel_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Mojang 下载渠道">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Source="ms-appx:///Assets/java-mojang.png" Width="40" Height="40"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Mojang" FontWeight="SemiBold"/><TextBlock Text="Minecraft 官方游戏运行时" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
   <Button Tag="Temurin" Click="Channel_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Eclipse Temurin 下载渠道">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Source="ms-appx:///Assets/java-temurin.svg" Width="40" Height="40"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Eclipse Temurin" FontWeight="SemiBold"/><TextBlock Text="Eclipse Adoptium · JDK" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
   <Button Tag="Zulu" Click="Channel_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Zulu 下载渠道">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Source="ms-appx:///Assets/java-zulu.svg" Width="44" Height="40"/>
     <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Zulu" FontWeight="SemiBold"/><TextBlock Text="Azul Zulu · JDK" FontSize="12" Foreground="#6B7A70"/></StackPanel>
    </Grid>
   </Button>
  </StackPanel>
  <StackPanel x:Name="VersionPanel" Spacing="12" Visibility="Collapsed">
   <TextBlock x:Name="VersionHint" TextWrapping="Wrap" Foreground="#6B7A70"/>
   <ProgressBar x:Name="VersionLoading" IsIndeterminate="True" Visibility="Collapsed"/>
   <ListView x:Name="Versions" MaxHeight="280" SelectionMode="Single" SelectionChanged="Version_SelectionChanged" AutomationProperties.Name="可用 Java 版本">
    <ListView.ItemTemplate><DataTemplate x:DataType="services:JavaPackage"><StackPanel Spacing="4" Padding="4,6"><TextBlock Text="{x:Bind Label}"/><TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="#6B7A70"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Button x:Name="RetryButton" Content="重新加载版本" Click="Retry_Click" Visibility="Collapsed"/>
  </StackPanel>
  <InfoBar x:Name="Error" Severity="Error" IsClosable="False"/>
 </StackPanel>
 </StackPanel>
</ContentDialog>
