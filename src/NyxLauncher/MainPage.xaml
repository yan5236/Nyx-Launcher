<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NyxLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NyxLauncher.Views"
    AllowDrop="True" DragOver="AuthServer_DragOver" Drop="AuthServer_Drop" RequestedTheme="Light">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AccentButtonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="192"
                    IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneOpen="True" AlwaysShowHeader="False"
                    IsTitleBarAutoPaddingEnabled="False" Background="#F0F3EC"
                    SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F0F3EC" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FAFBF8" />
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="8,2" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="首页" Tag="home">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="VersionsItem" Content="版本管理" Tag="versions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DownloadsItem" Content="下载" Tag="downloads">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="AccountMenuButton" Margin="8,8,8,12" Padding="10" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="未添加账户，打开账户菜单">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32">
                        <views:AccountAvatar x:Name="AccountAvatar" Width="32" Height="32" Visibility="Collapsed" />
                        <FontIcon x:Name="EmptyAccountIcon" Glyph="&#xE77B;" FontSize="24" />
                    </Grid>
                    <TextBlock x:Name="AccountName" Grid.Column="1" Text="未添加账户" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Text="账户" FontSize="15" MinWidth="168" Click="Account_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="设置" FontSize="15" Click="Settings_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </NavigationView.PaneFooter>
        <Grid x:Name="ContentHost" Padding="28,20,28,28" MaxWidth="1280" HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="HomeScroll" SizeChanged="Home_SizeChanged" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <views:HomeView x:Name="HomeContent" />
            </ScrollViewer>
            <Grid x:Name="VersionsScroll" Visibility="Collapsed">
                <views:VersionsView x:Name="VersionsContent" />
            </Grid>
            <views:DownloadsView x:Name="DownloadsContent" Visibility="Collapsed" />
            <views:AccountsView x:Name="AccountContent" Visibility="Collapsed" />
            <Grid x:Name="SettingsScroll" Visibility="Collapsed">
                <views:SettingsView x:Name="SettingsContent" />
            </Grid>
        </Grid>
    </NavigationView>
</Page>
