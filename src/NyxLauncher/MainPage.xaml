<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NyxLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NyxLauncher.Views"
    AllowDrop="True" DragOver="AuthServer_DragOver" Drop="AuthServer_Drop" Unloaded="Page_Unloaded">
    <Page.Resources>
        <Storyboard x:Name="PageEntrance" FillBehavior="Stop">
            <DoubleAnimation Storyboard.TargetName="PageSurface" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PageOffset" Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="192"
                    IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneOpen="True" AlwaysShowHeader="False"
                    IsTitleBarAutoPaddingEnabled="False" Background="Transparent"
                    PaneOpening="Navigation_PaneOpening" PaneClosing="Navigation_PaneClosing"
                    SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="8,2" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="首页" Tag="home">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="VersionsItem" Content="版本管理" Tag="versions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DownloadsItem" Content="下载" Tag="downloads">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="WardrobeItem" Content="衣柜" Tag="wardrobe">
                <NavigationViewItem.Icon><ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/hanger.svg" /></ImageIcon.Source></ImageIcon></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="AccountMenuButton" Margin="8,8,8,12" Padding="10" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="未添加账户，打开账户菜单">
                <Grid x:Name="AccountMenuLayout" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32">
                        <views:AccountAvatar x:Name="AccountAvatar" Width="32" Height="32" Visibility="Collapsed" />
                        <FontIcon x:Name="EmptyAccountIcon" Glyph="&#xE77B;" FontSize="24" />
                    </Grid>
                    <TextBlock x:Name="AccountName" Grid.Column="1" Text="未添加账户" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <FontIcon x:Name="AccountChevron" Grid.Column="2" Glyph="&#xE70E;" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="True"
                                MenuFlyoutPresenterStyle="{StaticResource OpaqueMenuPresenterStyle}" Opening="AccountMenu_Opening">
                        <MenuFlyoutItem Text="账户" FontSize="15" MinWidth="168" Click="Account_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="设置" FontSize="15" Click="Settings_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </NavigationView.PaneFooter>
        <Grid x:Name="ContentHost" Padding="28,20,28,0" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid x:Name="PageSurface">
                <Grid.RenderTransform><TranslateTransform x:Name="PageOffset" /></Grid.RenderTransform>
                <ScrollViewer x:Name="HomeScroll" SizeChanged="Home_SizeChanged" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <views:HomeView x:Name="HomeContent" />
                </ScrollViewer>
                <Grid x:Name="VersionsScroll" x:Load="False" Visibility="Collapsed">
                    <views:VersionsView x:Name="VersionsContent" />
                </Grid>
                <views:DownloadsView x:Name="DownloadsContent" x:Load="False" Visibility="Collapsed" />
                <views:AccountsView x:Name="AccountContent" x:Load="False" Visibility="Collapsed" />
                <views:WardrobeView x:Name="WardrobeContent" x:Load="False" Visibility="Collapsed" />
                <Grid x:Name="SettingsScroll" x:Load="False" Visibility="Collapsed">
                    <views:SettingsView x:Name="SettingsContent" />
                </Grid>
            </Grid>
            <InfoBar x:Name="CrashToast" HorizontalAlignment="Right" VerticalAlignment="Top"
                     MaxWidth="380" IsClosable="False" Severity="Informational"
                     Message="检测到游戏崩溃，正在分析…" />
        </Grid>
    </NavigationView>
</Page>
