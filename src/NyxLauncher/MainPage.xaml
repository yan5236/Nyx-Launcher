<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NyxLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NyxLauncher.Views"
    RequestedTheme="Light">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="192"
                    IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneOpen="True" AlwaysShowHeader="False"
                    IsTitleBarAutoPaddingEnabled="False" Background="#F0F3EC"
                    SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F0F3EC" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FAFBF8" />
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="8,2" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="首页" Tag="home">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="版本管理" Tag="versions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="下载" Tag="downloads">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button Margin="8,8,8,12" Padding="10" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Steve，打开账户菜单">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#DCE6D4" CornerRadius="6" Width="32" Height="32">
                        <Image Source="ms-appx:///Assets/Avatar.svg" Width="32" Height="32" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Steve" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Text="账户" FontSize="15" MinWidth="168" Click="Account_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="设置" FontSize="15" Click="Settings_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </NavigationView.PaneFooter>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,20,28,28" MaxWidth="1280" HorizontalAlignment="Stretch">
                <views:HomeView x:Name="HomeContent" />
                <views:VersionsView x:Name="VersionsContent" Visibility="Collapsed" />
                <views:DownloadsView x:Name="DownloadsContent" Visibility="Collapsed" />
                <StackPanel x:Name="AccountContent" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="账户" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="#DCE6D4" CornerRadius="12" Padding="16">
                                <Image Source="ms-appx:///Assets/Avatar.svg" Width="48" Height="48" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Steve" FontSize="22" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="切换账户" IsEnabled="False" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button Content="添加账户" IsEnabled="False" />
                </StackPanel>
                <StackPanel x:Name="SettingsContent" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <TextBlock Text="外观" FontSize="16" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="0" IsEnabled="False" FontSize="15" Width="180"
                                      HorizontalAlignment="Right" AutomationProperties.Name="外观">
                                <ComboBoxItem Content="浅色" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <TextBlock Text="游戏目录" FontSize="16" VerticalAlignment="Center" />
                            <Button Content="选择文件夹" IsEnabled="False" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>
