<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NyxLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NyxLauncher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NyxLauncher"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ThemeRoot" Background="{ThemeResource ShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="WindowBackground" Grid.RowSpan="2" Stretch="UniformToFill" IsHitTestVisible="False" />
        <TitleBar x:Name="AppTitleBar" Title="Nyx Launcher" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested"><TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/NyxLogo.png" ShowAsMonochrome="False" /></TitleBar.IconSource></TitleBar>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
