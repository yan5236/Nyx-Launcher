<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NyxLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NyxLauncher"
    xmlns:themes="using:NyxLauncher.Themes">
    <!-- 全局视觉令牌：颜色、圆角、字号与按钮样式统一在此定义，约束见仓库根目录 Design.md。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/AccentButtonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 以下画刷为启动前的占位值，运行时由 ThemeManager 按明暗与主题色原地更新。 -->
            <SolidColorBrush x:Key="ShellBrush" Color="#EEF2EE" />
            <SolidColorBrush x:Key="PageBrush" Color="#F7F9F7" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#F1F5F2" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#E7EEE9" />
            <SolidColorBrush x:Key="LineBrush" Color="#DCE3DD" />
            <SolidColorBrush x:Key="TextBrush" Color="#1C2721" />
            <SolidColorBrush x:Key="MutedBrush" Color="#5E6B63" />
            <SolidColorBrush x:Key="TintBrush" Color="#E0EBD6" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#2F7A4E" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="DangerLineBrush" Color="#E8B4AF" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2B6B45" />
            <SolidColorBrush x:Key="SidebarGlassBrush" Color="#F3F6F3" />
            <SolidColorBrush x:Key="SheetGlassBrush" Color="#F3F6F3" />
            <SolidColorBrush x:Key="DeckGlassBrush" Color="#F3F6F3" />

            <!-- 圆角层级：控件 8，浮层 12，卡片 12，大面板 16。覆盖 WinUI 默认值使原生控件同步变圆润。 -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="SheetCornerRadius">16</CornerRadius>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>
            <!-- 首页问候等展示性大标题；仅用于背景场景之上，不用于页面标题。 -->
            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="OpaqueMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="Background" Value="{ThemeResource MenuSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
            </Style>
            <Style x:Key="CardListItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter ContentMargin="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"
                                Control.IsTemplateFocusTarget="True" ContentTransitions="{TemplateBinding ContentTransitions}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                PointerOverBackground="{ThemeResource CardHoverBrush}"
                                PressedBackground="{ThemeResource CardPressedBrush}"
                                DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                FocusBorderBrush="{ThemeResource SecondaryBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 普通按钮：8 圆角，按下时以合成线程缩放到 97% 再回弹。 -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="themes:Motion.Press" Value="True" />
            </Style>
            <!-- 主操作按钮：主题主色实底，每个视图最多一个。 -->
            <Style x:Key="DeepButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="themes:Motion.Press" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
